<Window x:Class="ADHardenKit.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ADHardenKit.Gui.ViewModels"
        xmlns:views="clr-namespace:ADHardenKit.Gui.Views"
        Title="ADHardenKit" Width="1180" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StartViewModel}"><views:StartView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CheckViewModel}"><views:CheckView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><views:ScanView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigureViewModel}"><views:ConfigureView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreviewViewModel}"><views:PreviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeployViewModel}"><views:DeployView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinishViewModel}"><views:FinishView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: where you are in the wizard -->
        <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,24,16,16">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE83D;" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="ADHardenKit" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12">
                        <Run Text="Domain:" /> <Run Text="{Binding Domain, TargetNullValue='not joined', Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Journey.Title, StringFormat='Task: {0}', TargetNullValue=''}" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Text="{Binding Version, StringFormat='Version {0}'}" />

                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepViewModel}">
                            <Border x:Name="Row" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="24" Height="24" HorizontalAlignment="Left">
                                        <Ellipse x:Name="Dot" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                                        <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Tick" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed" Foreground="White" />
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="14" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Dot" Property="StrokeThickness" Value="2.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Page and navigation -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="32,12">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Back" MinWidth="100" Command="{Binding BackCommand}" />
                    <Button DockPanel.Dock="Right" Content="{Binding NextLabel}" MinWidth="160" Command="{Binding NextCommand}"
                            Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentStep}" Margin="32,28,32,24" MaxWidth="980" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
