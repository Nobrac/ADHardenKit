<UserControl x:Class="ADHardenKit.Gui.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ADHardenKit.Gui.ViewModels">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Preview" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="The engine ran in plan mode: it compared every setting in scope with what the GPOs hold today. Nothing has been written." />

        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RunStatusTemplate}" />

        <UniformGrid Columns="4" Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="{Binding PlannedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="values to write" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3,0,3,12">
                <StackPanel>
                    <TextBlock Text="{Binding CompliantCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="already in place" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3,0,3,12">
                <StackPanel>
                    <TextBlock Text="{Binding SkippedCount}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="skipped" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding WarningCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="warnings in the log" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}"
                Visibility="{Binding BlockingFindings.Count, Converter={x:Static vm:Converters.PositiveToVisibility}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="The engine scanned first: these still depend on what this Enforce run would require. Deploying will stop here unless you enforce anyway." />
                <ItemsControl ItemsSource="{Binding BlockingFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                <Run Text="{Binding Group, Mode=OneWay, StringFormat='[{0}]'}" FontWeight="SemiBold" /> <Run Text="{Binding Text, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="4" Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}">
            <DataGrid ItemsSource="{Binding Actions}" AutoGenerateColumns="False" IsReadOnly="True" Height="380"
                      HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                    <DataGridTextColumn Header="Group" Binding="{Binding Area}" Width="130" />
                    <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="2*" />
                    <DataGridTextColumn Header="Where" Binding="{Binding Target}" Width="2*" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Orientation="Horizontal">
            <Button Content="Plan again" Command="{Binding RunPreviewCommand}" />
            <Button Content="Open the plan report" Margin="8,0,0,0" Command="{Binding OpenReportCommand}"
                    Visibility="{Binding ReportHtml, Converter={x:Static vm:Converters.NotNullToVisibility}}" />
        </StackPanel>

        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RunLogTemplate}" />
    </StackPanel>
</UserControl>
