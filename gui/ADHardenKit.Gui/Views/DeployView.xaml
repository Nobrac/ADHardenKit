<UserControl x:Class="ADHardenKit.Gui.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ADHardenKit.Gui.ViewModels">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Deploy" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />

        <!-- Confirmation -->
        <Border Style="{StaticResource Card}" Visibility="{Binding Succeeded, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
            <StackPanel>
                <CheckBox IsChecked="{Binding Reviewed}" Content="I have reviewed the preview and want these GPOs written." />
                <StackPanel Visibility="{Binding NeedsDomainConfirmation, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"
                               Text="This run enforces. It is the one that can break authentication for clients the scan has not seen." />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,4">
                        <Run Text="Type the domain name to confirm:" /> <Run Text="{Binding Owner.Domain, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBox Text="{Binding ConfirmDomain, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260" />
                </StackPanel>
                <Button Content="Deploy now" Margin="0,16,0,0" HorizontalAlignment="Left" MinWidth="160"
                        Style="{DynamicResource AccentButtonStyle}" Command="{Binding DeployNowCommand}" />
            </StackPanel>
        </Border>

        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RunStatusTemplate}"
                        Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}" />

        <!-- Stopped by the Enforce gate -->
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource ErrorBrush}" Visibility="{Binding Blocked, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="Nothing was written. These still depend on what this run would enforce:" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding BlockingFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                <Run Text="{Binding Group, Mode=OneWay, StringFormat='[{0}]'}" FontWeight="SemiBold" /> <Run Text="{Binding Text, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,8" Text="Fix them and scan again - that is the safe path. Only enforce anyway if you have checked each one is harmless." />
                <CheckBox IsChecked="{Binding ForceAcknowledged}" Content="I checked these findings and accept that the affected clients may stop working." />
                <Button Content="Enforce anyway" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding ForceDeployCommand}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}" Padding="4">
            <DataGrid ItemsSource="{Binding Actions}" AutoGenerateColumns="False" IsReadOnly="True" Height="300"
                      HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                    <DataGridTextColumn Header="Group" Binding="{Binding Area}" Width="130" />
                    <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="2*" />
                    <DataGridTextColumn Header="Where" Binding="{Binding Target}" Width="2*" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RunLogTemplate}" />
    </StackPanel>
</UserControl>
