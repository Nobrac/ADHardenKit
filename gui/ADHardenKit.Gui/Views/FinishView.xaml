<UserControl x:Class="ADHardenKit.Gui.Views.FinishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ADHardenKit.Gui.ViewModels">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Done" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Headline}" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Open the report" Style="{DynamicResource AccentButtonStyle}" Command="{Binding LastRun.OpenReportCommand}" MinWidth="160" />
            <Button Content="Open the log folder" Margin="8,0,0,0" Command="{Binding LastRun.OpenLogFolderCommand}" />
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="What comes next" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding NextSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" VerticalAlignment="Top" Margin="0,3,8,0" />
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                   Text="Rolling back: unlink the GPO in the Group Policy Management Console. Most security options stay on the machines after unlinking - the README's rollback section lists how to revert them." />
    </StackPanel>
</UserControl>
